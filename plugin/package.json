{
  "name": "dsh-team-chat",
  "version": "0.3.2",
  "description": "A shared chat room for an existing DeepSeek Harness Agent Team",
  "type": "module",
  "main": "./src/host.js",
  "exports": {
    ".": "./src/host.js",
    "./client": "./lib/client.js",
    "./harness-adapter": { "types": "./src/harness-adapter.d.ts", "default": "./src/harness-adapter.js" },
    "./workflow-engine": "./src/workflow.js",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "src",
    "lib/client.js",
    "test",
    "build.mjs",
    "README.md",
    "COMPARISON.md",
    "HARNESS-ADAPTER.md"
  ],
  "engines": {
    "node": ">=24.9.0",
    "dsh": "0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-storage-domain": "0.2.2-rc.1",
    "@deepseek-ai/dsh-subagent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.1"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/*.test.js"
  }
}
